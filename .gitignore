# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code (local machine settings)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kick_categories.json is committed — lib/data/all-categories.ts imports it at
# build time, so CI needs it in the repo (do not re-ignore it).
*.png
# public/avatar.png is the default avatar fallback served in production
# (rendered by every avatar with no image) — must be committed.
!public/avatar.png
# public/thumbnails/ is committed — category cards serve from it in production
.expo/

# Treasury keypairs — NEVER commit
.treasury-keys/

# Cloudflare / OpenNext
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts
.cf-secrets.json

# cron worker generated secrets bundle
cron/.cf-secrets.json

# Local agent / MCP tooling — do not commit
.headroom/
.serena/
.mcp.json

# Agent skills (installed globally, not per-project)
.agents/
skills-lock.json
.claude/skills/
.claude/scheduled_tasks.lock

# Wallet ciphertext backups from master-key rotation — never commit
.wallet-backups/

# deepsec AI vulnerability scanner workspace (large + contains findings)
.deepsec/

.smoke/
.walk-cookie
.deepsec-run.log

# Nested worker deps (installed in CI, like realtime)
og-worker/node_modules

# Python bytecode from the phoenix service (build artifact, regenerated on run)
__pycache__/
*.py[cod]
