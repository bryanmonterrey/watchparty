# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code (local machine settings)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kick scraping
kick_categories.json
*.png
# public/thumbnails/ is committed — category cards serve from it in production
.expo/

# Treasury keypairs — NEVER commit
.treasury-keys/

# Cloudflare / OpenNext
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts
.cf-secrets.json

# cron worker generated secrets bundle
cron/.cf-secrets.json
