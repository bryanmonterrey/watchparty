# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code (local machine settings)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kick_categories.json is committed — lib/data/all-categories.ts imports it at
# build time, so CI needs it in the repo (do not re-ignore it).
*.png
# public/avatar.png is the default avatar fallback served in production
# (rendered by every avatar with no image) — must be committed.
!public/avatar.png
# public/og-default.png is the brand share card every link falls back to
# (lib/share/metadata.ts); rendered by scripts/dev/render-og-default.mjs.
!public/og-default.png
# public/emoji/ is the emoji.gg pack art, built by scripts/build-emoji-packs.mjs
# and served in production by the picker and by chat. 64 of the 80 files are
# PNGs, so without this negation the blanket *.png rule silently drops them from
# the commit and every one of them 404s on the deploy.
!public/emoji/**/*.png
# public/noise-color.png is the grain laid over every popover surface (the SVG
# pattern in components/liquid/ and the .surface-noise utility in globals.css).
# Without this negation it 404s on the deploy and the panels go back to flat.
!public/noise-color.png
# public/thumbnails/ is committed — category cards serve from it in production
.expo/

# Treasury keypairs — NEVER commit
.treasury-keys/

# Cloudflare / OpenNext
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts
.cf-secrets.json

# cron worker generated secrets bundle
cron/.cf-secrets.json

# Local agent / MCP tooling — do not commit
.headroom/
.serena/
.mcp.json

# Agent skills (installed globally, not per-project)
.agents/
skills-lock.json
.claude/skills/
.claude/scheduled_tasks.lock

# Wallet ciphertext backups from master-key rotation — never commit
.wallet-backups/

# deepsec AI vulnerability scanner workspace (large + contains findings)
.deepsec/

.smoke/
.walk-cookie
.deepsec-run.log

# Nested worker deps (installed in CI, like realtime)
og-worker/node_modules

# Python bytecode from the phoenix service (build artifact, regenerated on run)
__pycache__/
*.py[cod]

# ── Private asset overlay (bryanmonterrey/watchparty-assets) ─────────────────
# Licensed packs and ops runbooks that the AGPL public repo cannot carry. They
# are copied over this tree at build time (scripts/ci/overlay-private-assets.sh,
# scripts/dev/pull-private-assets.sh) and must never be committed here again.
docs/vector-badges-pro/
docs/vector-ranks/
docs/vector-emojis/
docs/Free Icon Pack v3.1 (Basic)/
docs/*-emojigg-pack/
public/emoji/
private-docs/
docs/treasury-security.md
docs/cloudflare-launch.md
docs/premium-ops.md
docs/better-auth-1.7.7-migration.md
docs/oauth-provider.md
docs/console-backlog-plans.md
docs/billing-restart-runbook.md
