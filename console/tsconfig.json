{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // Fallback into the parent repo (the mobile/ pattern) so type-only
      // imports like `import type { AppRouter } from "@/server/routers"`
      // resolve — and so do the `@/…` imports inside those parent files.
      // TYPES ONLY: console files win on collisions, and anything the
      // bundler must ship (cn, the price sheet) is vendored locally in
      // console/lib — Turbopack refuses runtime imports outside the app
      // root (next.config.ts pins it).
      "@/*": [
        "./*",
        "../*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
