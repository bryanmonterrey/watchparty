{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "watchparty-og",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  // Standalone OG share-image renderer, split out of the main Next app because
  // `next/og` bundles resvg.wasm (1.3 MiB) + yoga.wasm + a font into the worker
  // — ~1 MiB that pushed the main `watchparty` worker over the 10 MiB upload
  // cap. This worker carries that weight instead; the main worker gets its
  // headroom back. See the memory `worker-bundle-size-ceiling`.
  //
  // ZONE ROUTE — set OUT OF BAND in the Cloudflare dashboard, NOT here.
  // Verified 2026-08-12: the CI deploy token lacks Workers Routes edit
  // permission (route creation via wrangler returns Authentication error
  // 10000), same reason console.watchparty.xyz/api/* was wired by hand. If
  // `routes` lived in this config, every `wrangler deploy` would try to
  // recreate the route and fail the whole job even though the worker uploaded
  // fine — so the route stays a one-time dashboard step:
  //
  //   Workers & Pages → watchparty-og → Settings → Domains & Routes → Add route
  //     Route:  watchparty.xyz/api/og/*
  //     Zone:   watchparty.xyz
  //
  // A route pattern outranks the origin worker's catch-all, so once it's added
  // the SAME share URLs the app builds (origin + /api/og/post?...) resolve
  // here with no client change. Only AFTER the route is live should the app's
  // own /api/og route be removed (that's what reclaims the bundle headroom).
  "observability": { "enabled": true }
}
