{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "watchparty-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  // Drives the premium/treasury/feed crons by calling the app's guarded endpoints.
  // Collect hourly; sweep every 30 min; feed-corpus hourly at :17 (own slot so it
  // never coincides with the others); assets-webhook sync daily at 04:30 UTC;
  // callout-performance every 10 min; ivs-viewers + token-sync + coin-alerts
  // every minute (the Cloudflare cron floor — keeps market data, live state and
  // the coin alert rail near-realtime);
  // predictions-factory hourly at :07 (AI market generation + auto-resolve).
  // Dispatched by event.cron in code.
  "triggers": { "crons": ["0 * * * *", "*/30 * * * *", "17 * * * *", "30 4 * * *", "*/10 * * * *", "* * * * *", "7 * * * *"] },
  "vars": { "TARGET_BASE_URL": "https://watchparty.xyz", "ALERT_EMAIL": "bryan@watchparty.xyz" },
  "observability": { "enabled": true }
  // CRON_SECRET is a secret and MUST equal the app's CRON_SECRET. Set out-of-band:
  //   cd cron && wrangler secret put CRON_SECRET
}
