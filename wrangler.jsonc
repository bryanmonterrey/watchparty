{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchparty",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Persist worker logs (console/errors) to Cloudflare Workers Logs so
  // production errors are queryable after the fact (dashboard → Workers →
  // watchparty → Logs) instead of only visible in a live `wrangler tail`.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Supabase session pooler (DIRECT_URL) fronted by Hyperdrive — the DB client
  // in db/index.ts reads env.HYPERDRIVE.connectionString on Workers.
  // Config swapped 2026-08-06: the original config (85d170665be54585b8f8124bd9fbb404,
  // "watchparty-db") wedged internally — every query queued forever while the DB sat
  // idle — and a config modification did not clear it. Fresh id = fresh pool state.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ba858f4c848844f8af5b003f453fd693"
    }
  ]
  // Added later for ISR/revalidation caching (mirrors the playground16 example):
  //   "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "watchparty-cache" }]
  //   "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "watchparty" }]
}
