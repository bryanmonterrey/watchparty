{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchparty",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Persist worker logs (console/errors) to Cloudflare Workers Logs so
  // production errors are queryable after the fact (dashboard → Workers →
  // watchparty → Logs) instead of only visible in a live `wrangler tail`.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Supabase session pooler (DIRECT_URL) fronted by Hyperdrive — the DB client
  // in db/index.ts reads env.HYPERDRIVE.connectionString on Workers.
  // HYPERDRIVE BINDING REMOVED 2026-08-06 (outage): with the binding present the
  // worker routes queries into Hyperdrive, and every query through it hung
  // forever (config swap 85d17066…→ba858f4c… and origin changes did not help)
  // while direct pooler connections stayed healthy. Without the binding,
  // db/index.ts uses the per-request client against DATABASE_URL (transaction
  // pooler :6543). Restore the binding only after proving Hyperdrive serves
  // queries again.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "ba858f4c848844f8af5b003f453fd693"
  //   }
  // ]
  // Added later for ISR/revalidation caching (mirrors the playground16 example):
  //   "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "watchparty-cache" }]
  //   "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "watchparty" }]
}
